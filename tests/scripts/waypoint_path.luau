local dquat_lib = require("lib/dquat")

local SQUARE = "0 0 0; 100 0 0; 100 100 0; 0 100 50"

local function rider(props, name)
    local entity = sim.spawn(name or "Rider", {})
    sim.attach(entity, "waypoint_path", props)
    return entity
end

local function position(entity)
    return scene.get64(entity, "Transform", "Position")
end

local function at_time(seconds)
    sim.step(math.floor(seconds / sim.dt() + 0.5) + 1 - sim.ticks())
end

local function marker(name, x, y, z)
    local entity = sim.spawn(name, {})
    scene.set64(entity, "Transform", "Position", dvec3.new(x, y, z))
    return entity
end

test("constant speed covers an equal distance every tick", function()
    local entity = rider({ Points = SQUARE, Speed = 30 })
    sim.step(1)
    local previous = position(entity)
    local step = 30 * sim.dt()
    for i = 1, 240 do
        sim.step(1)
        local now = position(entity)
        assert_near(dvec3.distance(now, previous), step, step * 0.01, "tick " .. i)
        previous = now
    end
end)

test("the path starts at the first waypoint and ends on the last", function()
    local entity = rider({ Points = SQUARE, Speed = 50 })
    sim.step(1)
    assert_near(position(entity), dvec3.new(0, 0, 0), 1e-9)
    at_time(100)
    assert_near(position(entity), dvec3.new(0, 100, 50), 1e-9)
end)

test("a duration sets the speed from the path length", function()
    local entity = rider({ Points = "0 0 0; 100 0 0", Duration = 4 })
    sim.set_dt(0.5)
    at_time(2)
    assert_near(position(entity), dvec3.new(50, 0, 0), 1e-9)
    at_time(4)
    assert_near(position(entity), dvec3.new(100, 0, 0), 1e-9)
end)

test("an easing on a duration run bends the progress", function()
    local entity = rider({ Points = "0 0 0; 100 0 0", Duration = 4, Ease = "in_quad" })
    sim.set_dt(0.5)
    at_time(2)
    assert_near(position(entity), dvec3.new(25, 0, 0), 1e-9)
end)

test("a time law reaches every waypoint at its time", function()
    marker("W1", 0, 0, 0)
    marker("W2", 40, 10, 0)
    marker("W3", 40, 80, 10)
    marker("W4", -30, 80, 60)
    local entity = rider({ Waypoints = "W1; W2; W3; W4", TimeLaw = "0 0; 2 1; 5 2; 9 3" })
    sim.set_dt(0.5)
    local expected = { [0] = dvec3.new(0, 0, 0), [2] = dvec3.new(40, 10, 0), [5] = dvec3.new(40, 80, 10), [9] = dvec3.new(-30, 80, 60) }
    for _, time_value in { 0, 2, 5, 9 } do
        at_time(time_value)
        assert_near(position(entity), expected[time_value], 1e-9, "t=" .. time_value)
    end
    at_time(20)
    assert_near(position(entity), expected[9], 1e-9)
end)

test("time law easing applies between keys", function()
    marker("W1", 0, 0, 0)
    marker("W2", 10, 0, 0)
    local entity = rider({ Waypoints = "W1; W2", TimeLaw = "0 0 in_quad; 4 1" })
    sim.set_dt(0.5)
    at_time(2)
    assert_near(position(entity), dvec3.new(2.5, 0, 0), 1e-9)
end)

test("a time law can wait before it starts and hold after it ends", function()
    local entity = rider({ Points = "0 0 0; 10 0 0", TimeLaw = "2 0; 4 1" })
    sim.set_dt(0.5)
    at_time(1)
    assert_near(position(entity), dvec3.new(0, 0, 0), 1e-9)
    at_time(3)
    assert_near(position(entity), dvec3.new(5, 0, 0), 1e-9)
    at_time(9)
    assert_near(position(entity), dvec3.new(10, 0, 0), 1e-9)
end)

test("jumping the clock gives the same position as stepping to it", function()
    local entity = rider({ Points = "0 0 0; 1000 0 0", Speed = 20 })
    sim.set_dt(0.25)
    at_time(10)
    assert_near(position(entity), dvec3.new(200, 0, 0), 1e-9)
    sim.set_dt(30)
    sim.step(1)
    assert_near(position(entity), dvec3.new(205, 0, 0), 1e-9)
    sim.set_dt(0.25)
    sim.step(1)
    assert_near(position(entity), dvec3.new(805, 0, 0), 1e-9)
end)

test("the position follows the clock, not the number of ticks", function()
    local entity = rider({ Points = "0 0 0; 1000 0 0", Speed = 20 })
    sim.set_dt(8)
    sim.step(1)
    sim.set_dt(2)
    sim.step(2)
    assert_near(position(entity), dvec3.new(200, 0, 0), 1e-9)
end)

test("a path 1e11 m from the origin keeps millimetre precision", function()
    local far = "100000000000 -250000000000 300000000000; 100000000500 -250000000000 300000000000; 100000001000 -250000000000 300000000000"
    local entity = rider({ Points = far, Speed = 7.25 })
    sim.set_dt(1 / 64)
    sim.step(1)
    local start = dvec3.new(1e11, -2.5e11, 3e11)
    for _, tick in { 64, 200, 400 } do
        sim.step(tick - sim.ticks() + 1)
        local expected = start + dvec3.new(7.25 * (tick / 64), 0, 0)
        assert(dvec3.distance(position(entity), expected) < 1e-3, "tick " .. tick .. " off by " .. dvec3.distance(position(entity), expected))
    end
end)

test("waypoint entities at 1e11 m work and the spline passes through them exactly", function()
    marker("A", 1.5e11, 2e10, -3e10)
    marker("B", 1.5e11 + 4e6, 2e10 + 1e6, -3e10)
    marker("C", 1.5e11 + 9e6, 2e10 - 2e6, -3e10 + 5e5)
    local entity = rider({ Waypoints = "A; B; C", TimeLaw = "0 0; 3 1; 8 2" })
    sim.set_dt(0.5)
    at_time(3)
    assert(dvec3.distance(position(entity), dvec3.new(1.5e11 + 4e6, 2e10 + 1e6, -3e10)) < 1e-3)
    at_time(8)
    assert(dvec3.distance(position(entity), dvec3.new(1.5e11 + 9e6, 2e10 - 2e6, -3e10 + 5e5)) < 1e-3)
end)

test("a moving waypoint entity re-shapes the path", function()
    local a = marker("A", 0, 0, 0)
    local b = marker("B", 10, 0, 0)
    local entity = rider({ Waypoints = "A; B", Speed = 1, Mode = 0 })
    sim.step(2)
    scene.set64(b, "Transform", "Position", dvec3.new(0, 20, 0))
    sim.step(1)
    local p = position(entity)
    assert(math.abs(p.x) < 1e-6 and p.y > 0, "path did not follow the marker")
end)

test("once ends on the last waypoint and signals done exactly once", function()
    local entity = rider({ Points = "0 0 0; 10 0 0", Duration = 2, Name = "cam" })
    sim.set_dt(0.5)
    sim.step(4)
    assert_eq(#sim.events("waypoint_path_done"), 0)
    sim.step(10)
    local done = sim.events("waypoint_path_done")
    assert_eq(#done, 1)
    assert_eq(done[1].args[1], "cam")
    assert_near(position(entity), dvec3.new(10, 0, 0), 1e-9)
end)

test("the done event names the entity when Name is empty", function()
    rider({ Points = "0 0 0; 10 0 0", Duration = 1 }, "Dolly")
    sim.set_dt(0.5)
    sim.step(6)
    assert_eq(sim.events("waypoint_path_done")[1].args[1], "Dolly")
end)

test("loop restarts at the first waypoint and counts laps", function()
    local entity = rider({ Points = "0 0 0; 10 0 0", Duration = 2, Mode = 1 })
    sim.set_dt(0.5)
    at_time(1)
    assert_near(position(entity), dvec3.new(5, 0, 0), 1e-9)
    at_time(3)
    assert_near(position(entity), dvec3.new(5, 0, 0), 1e-9)
    at_time(4)
    assert_near(position(entity), dvec3.new(0, 0, 0), 1e-9)
    assert_eq(#sim.events("waypoint_path_done"), 0)
    assert_eq(#sim.events("waypoint_path_lap"), 2)
end)

test("pingpong runs back and forth", function()
    local entity = rider({ Points = "0 0 0; 10 0 0", Duration = 2, Mode = 2 })
    sim.set_dt(0.5)
    at_time(2)
    assert_near(position(entity), dvec3.new(10, 0, 0), 1e-9)
    at_time(3)
    assert_near(position(entity), dvec3.new(5, 0, 0), 1e-9)
    at_time(4)
    assert_near(position(entity), dvec3.new(0, 0, 0), 1e-9)
    at_time(5)
    assert_near(position(entity), dvec3.new(5, 0, 0), 1e-9)
end)

test("a closed spline loops through all waypoints and back", function()
    local entity = rider({ Points = "0 0 0; 10 0 0; 10 10 0; 0 10 0", Closed = true, Mode = 1, TimeLaw = "0 0; 4 4" })
    sim.set_dt(0.5)
    at_time(2)
    assert_near(position(entity), dvec3.new(10, 10, 0), 1e-9)
    at_time(4)
    assert_near(position(entity), dvec3.new(0, 0, 0), 1e-9)
end)

test("orientation keys slerp between their endpoints", function()
    local entity = rider({ Points = "0 0 0; 10 0 0", Speed = 1, Orientation = "0 0 0 0; 4 20 60 -30", Mode = 0 })
    sim.set_dt(0.5)
    at_time(0)
    assert_near(dquat_lib.angle(scene.get64(entity, "Transform", "Rotation"), dquat.new(0, 0, 0, 1)), 0, 1e-6)
    local last = dquat.from_euler(20, 60, -30)
    at_time(2)
    local half = dquat.slerp(dquat.new(0, 0, 0, 1), last, 0.5)
    assert_near(dquat_lib.angle(scene.get64(entity, "Transform", "Rotation"), half), 0, 1e-5)
    at_time(4)
    assert_near(dquat_lib.angle(scene.get64(entity, "Transform", "Rotation"), last), 0, 1e-5)
    at_time(30)
    assert_near(dquat_lib.angle(scene.get64(entity, "Transform", "Rotation"), last), 0, 1e-5)
end)

test("a target keeps the entity looking at it", function()
    local target = marker("Planet", 0, 0, -100)
    local entity = rider({ Points = "0 0 0; 100 0 0", Speed = 10, Target = target })
    sim.set_dt(0.5)
    at_time(5)
    local forward = dquat_lib.forward(scene.get64(entity, "Transform", "Rotation"))
    local expected = dvec3.normalize(dvec3.new(0, 0, -100) - position(entity))
    assert_near(forward, expected, 1e-4)
end)

test("face travel points along the path", function()
    local entity = rider({ Points = "0 0 0; 100 0 -100", Speed = 10, FaceTravel = true })
    sim.set_dt(0.5)
    at_time(2)
    assert_near(dquat_lib.forward(scene.get64(entity, "Transform", "Rotation")), dvec3.new(math.sqrt(0.5), 0, -math.sqrt(0.5)), 1e-5)
end)

test("orientation keys beat a target", function()
    local target = marker("Planet", 0, 0, -100)
    local entity = rider({ Points = "0 0 0; 100 0 0", Speed = 10, Target = target, Orientation = "0 0 0 0" })
    sim.step(3)
    assert_near(dquat_lib.angle(scene.get64(entity, "Transform", "Rotation"), dquat.new(0, 0, 0, 1)), 0, 1e-6)
end)

test("camera rig mode animates the field of view and takes the primary flag", function()
    local other = sim.spawn("Other", { Camera = { Primary = true } })
    local camera = sim.spawn("Camera", { Camera = { Primary = false, Fov = 60 } })
    sim.attach(camera, "waypoint_path", { Points = "0 0 0; 10 0 0", Speed = 1, FovKeys = "0 60; 4 30 smoothstep", MakePrimary = true })
    sim.set_dt(0.5)
    at_time(0)
    assert_near(scene.get(camera, "Camera", "Fov"), 60, 1e-5)
    assert(scene.get(camera, "Camera", "Primary"))
    assert(not scene.get(other, "Camera", "Primary"))
    at_time(2)
    assert_near(scene.get(camera, "Camera", "Fov"), 45, 1e-5)
    at_time(4)
    assert_near(scene.get(camera, "Camera", "Fov"), 30, 1e-5)
end)

test("a non-camera entity ignores FovKeys", function()
    rider({ Points = "0 0 0; 10 0 0", Speed = 1, FovKeys = "0 60; 4 30" })
    sim.step(5)
end)

test("bad configuration is a script error with a readable message", function()
    rider({ Points = "0 0 0" })
    local message = expect_error(function() sim.step(1) end, "at least 2 waypoints")
    assert(string.find(message, "waypoint_path", 1, true))
end)

test("an unknown waypoint name is an error", function()
    rider({ Waypoints = "Nowhere; Elsewhere" })
    expect_error(function() sim.step(1) end, "unknown waypoint 'Nowhere'")
end)

test("a time law past the last waypoint is an error", function()
    rider({ Points = "0 0 0; 10 0 0", TimeLaw = "0 0; 4 5" })
    expect_error(function() sim.step(1) end, "time law reaches waypoint")
end)

test("a point with a missing coordinate is an error", function()
    rider({ Points = "0 0 0; 10 0" })
    expect_error(function() sim.step(1) end, "bad point")
end)

test("waypoints can be named by guid", function()
    local a = marker("A", 0, 0, 0)
    local b = marker("B", 10, 0, 0)
    local function guid(entity)
        return tostring(tonumber(string.match(tostring(entity), "0x(%x+)"), 16))
    end
    local entity = rider({ Waypoints = guid(a) .. "; " .. guid(b), TimeLaw = "0 0; 2 1" })
    sim.set_dt(0.5)
    at_time(2)
    assert_near(position(entity), dvec3.new(10, 0, 0), 1e-9)
end)
