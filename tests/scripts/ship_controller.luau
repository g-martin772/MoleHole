local function spawn_ship(props, extra)
    local components = {
        RigidBody = { Type = 2, Mass = 100, EnableGravity = false },
        Collider = { Shape = 1, Radius = 1 },
    }
    for key, value in extra or {} do
        components[key] = value
    end
    local ship = sim.spawn("Ship", components)
    sim.set_velocity(ship, vector.create(0, 0, 0))
    local all = { ThrustX = 500, ThrustY = 500, ThrustZ = 500, TorquePitch = 400, TorqueYaw = 400, TorqueRoll = 400, ResponseTime = 0.2 }
    for key, value in props or {} do
        all[key] = value
    end
    sim.attach(ship, "ship_controller", all)
    return ship
end

local function velocity(ship) return scene.get64(ship, "Velocity", "Linear") end
local function spin(ship) return scene.get64(ship, "Velocity", "Angular") end

test("move axes thrust along the ship's right, up and forward", function()
    local ship = spawn_ship()
    sim.input("move_x")
    sim.input("move_y", -1)
    sim.input("move_z")
    sim.step(60)
    assert_near(velocity(ship), dvec3.new(5, -5, -5), 1e-2)
end)

test("without input the ship coasts", function()
    local ship = spawn_ship({ Assist = 0 })
    sim.step(1)
    physics.set_velocity(ship, vector.create(3, 0, 0))
    sim.step(60)
    assert_near(velocity(ship), dvec3.new(3, 0, 0), 1e-4)
end)

test("keyboard and mouse look turn the nose", function()
    local ship = spawn_ship({ Assist = 0 })
    sim.input("yaw")
    sim.step(10)
    assert(spin(ship).y < -0.1)
    sim.input("yaw", false)
    sim.input("pitch")
    sim.step(10)
    assert(spin(ship).x > 0.1)
    sim.input("pitch", false)
    sim.input("roll")
    sim.step(10)
    assert(spin(ship).z < -0.1)
end)

test("mouse up pitches up and invert flips it", function()
    local ship = spawn_ship({ Assist = 0 })
    for _ = 1, 10 do
        sim.input_mouse(0, -10)
        sim.step(1)
    end
    assert(spin(ship).x > 0.1)
    local other = spawn_ship({ Assist = 0, InvertPitch = true })
    for _ = 1, 10 do
        sim.input_mouse(0, -10)
        sim.step(1)
    end
    assert(spin(other).x < spin(ship).x)
end)

test("the assist key cycles off, rate, hold, retro", function()
    spawn_ship({ Assist = 1 })
    sim.step(1)
    for _ = 1, 4 do
        sim.input_tap("assist")
        sim.step(1)
    end
    local seen = {}
    for _, event in sim.events("assist_mode") do
        table.insert(seen, event.args[1])
    end
    assert_eq(seen, { 2, 3, 0, 1 })
end)

test("rate assist stops the spin that off leaves", function()
    local off = spawn_ship({ Assist = 0 })
    local damped = spawn_ship({ Assist = 1 })
    sim.step(1)
    physics.set_angular_velocity(off, vector.create(0, 1, 0))
    physics.set_angular_velocity(damped, vector.create(0, 1, 0))
    sim.step(120)
    assert(spin(off).y > 0.9)
    assert(math.abs(spin(damped).y) < 0.05)
end)

test("the G limit and mass override are properties", function()
    local limited = spawn_ship({ GLimit = 0.1 })
    local light = spawn_ship({ MassOverride = 25 })
    sim.input("move_z")
    sim.step(60)
    assert_near(dvec3.length(velocity(limited)), 0.1 * 9.80665, 1e-3)
    assert_near(dvec3.length(velocity(light)), 20, 1e-2)
end)

test("holding boost multiplies the thrust", function()
    local ship = spawn_ship({ Boost = 3 })
    sim.input("move_z")
    sim.input("boost")
    sim.step(60)
    assert_near(dvec3.length(velocity(ship)), 15, 1e-2)
end)

test("thrust is real newtons whatever the time scale", function()
    time.set_scale(0.01)
    local ship = spawn_ship({ ThrustZ = 5e4 })
    sim.input("move_z")
    sim.step(60)
    assert_near(dvec3.length(velocity(ship)), 5e4 / 100 * 0.01, 1e-3)
end)

test("a free-fly camera hands control away from the ship and back", function()
    local ship = spawn_ship()
    sim.input("move_z")
    sim.step(30)
    local gained = dvec3.length(velocity(ship))
    sim.emit("camera_mode", "fly")
    sim.step(30)
    assert_near(dvec3.length(velocity(ship)), gained, 0.1)
    sim.emit("camera_mode", "chase")
    sim.step(30)
    assert(dvec3.length(velocity(ship)) > gained + 2)
end)

test("a ship that is not dynamic is left alone and does not error", function()
    local ship = spawn_ship(nil, { RigidBody = { Type = 0, Mass = 100 } })
    sim.input("move_z")
    sim.step(5)
    assert_near(scene.get64(ship, "Transform", "Position"), dvec3.new(0, 0, 0), 1e-9)
end)

test("far from the origin the thrust is exact", function()
    local ship = spawn_ship()
    scene.set64(ship, "Transform", "Position", dvec3.new(7.4e5, 0, 0))
    sim.input("move_z")
    sim.step(60)
    assert_near(dvec3.length(velocity(ship)), 5, 1e-2)
end)

local function status()
    local list = sim.events("ship_status")
    return list[#list].args
end

local function nose(ship)
    return dquat.rotate(scene.get64(ship, "Transform", "Rotation"), dvec3.new(0, 0, -1))
end

test("the throttle keys ramp a setting that persists after release and scales thrust", function()
    local ship = spawn_ship({ Assist = 0, ThrottleRate = 1 })
    sim.input("throttle")
    sim.step(30)
    sim.input("throttle", false)
    local set = status()[1]
    assert_near(set, 0.5, 0.05)
    sim.step(60)
    assert_near(status()[1], set, 1e-9)
    local speed = dvec3.length(velocity(ship))
    assert(speed > 0)
    sim.step(60)
    assert_near(dvec3.length(velocity(ship)) - speed, set * 500 / 100, 0.05)
    sim.input("throttle", -1)
    sim.step(120)
    sim.input("throttle", false)
    assert_near(status()[1], 0, 1e-9)
end)

test("the throttle clamps at full and cut zeroes it", function()
    spawn_ship({ ThrottleRate = 10 })
    sim.input("throttle")
    sim.step(30)
    sim.input("throttle", false)
    assert_near(status()[1], 1, 1e-9)
    sim.input_tap("throttle_cut")
    sim.step(2)
    assert_near(status()[1], 0, 1e-9)
end)

test("a negative ThrottleMin gives a reverse range", function()
    local ship = spawn_ship({ Assist = 0, ThrottleRate = 10, ThrottleMin = -0.5 })
    sim.input("throttle", -1)
    sim.step(30)
    sim.input("throttle", false)
    assert_near(status()[1], -0.5, 1e-9)
    sim.step(30)
    assert(velocity(ship).z > 0)
end)

test("speed hold keeps the speed it was engaged at and drops on throttle", function()
    local ship = spawn_ship({ Assist = 0, ThrustX = 1000, ThrustY = 1000, ThrustZ = 1000, ResponseTime = 0.3 })
    sim.step(1)
    physics.set_velocity(ship, vector.create(0, 0, -12))
    sim.step(1)
    sim.input_tap("speed_hold")
    sim.step(2)
    assert_near(status()[6], 12, 0.5)
    physics.add_impulse(ship, vector.create(0, 0, -600))
    sim.step(300)
    assert_near(dvec3.length(velocity(ship)), status()[6], 0.1)
    sim.input("throttle")
    sim.step(2)
    assert_eq(status()[6], -1)
end)

test("kill velocity brings the ship to rest while the key is held", function()
    local ship = spawn_ship({ Assist = 0, ThrustX = 1000, ThrustY = 1000, ThrustZ = 1000, ResponseTime = 0.2 })
    sim.step(1)
    physics.set_velocity(ship, vector.create(5, 3, -8))
    sim.step(1)
    sim.input("kill_velocity")
    sim.step(300)
    assert(dvec3.length(velocity(ship)) < 0.05)
    assert_eq(status()[7], 1)
end)

test("MaxSpeed caps the speed that thrust can reach", function()
    local ship = spawn_ship({ Assist = 0, MaxSpeed = 4 })
    sim.input("move_z")
    sim.step(180)
    assert_near(dvec3.length(velocity(ship)), 4, 1e-3)
end)

test("keys alone turn the ship about every axis with the mouse untouched", function()
    local ship = spawn_ship({ Assist = 0, ControlMode = 1 })
    local function body_spin()
        return dquat.rotate(dquat.inverse(scene.get64(ship, "Transform", "Rotation")), spin(ship))
    end
    sim.input("yaw")
    sim.step(20)
    sim.input("yaw", false)
    assert(body_spin().y < -0.1)
    sim.input("pitch")
    sim.step(20)
    sim.input("pitch", false)
    assert(body_spin().x > 0.1)
    sim.input("roll")
    sim.step(20)
    sim.input("roll", false)
    assert(body_spin().z < -0.1)
    assert_eq(status()[5], 1)
end)

test("the mouse is ignored in keys-only mode and steers otherwise", function()
    local keys = spawn_ship({ Assist = 0, ControlMode = 1 })
    for _ = 1, 10 do
        sim.input_mouse(20, -20)
        sim.step(1)
    end
    assert_near(spin(keys), dvec3.new(0, 0, 0), 1e-9)
    local mouse = spawn_ship({ Assist = 0, ControlMode = 0 })
    for _ = 1, 10 do
        sim.input_mouse(20, -20)
        sim.step(1)
    end
    assert(dvec3.length(spin(mouse)) > 0.1)
end)

test("the control mode key toggles between mouse steering and keys only", function()
    local ship = spawn_ship({ Assist = 0 })
    sim.step(1)
    assert_eq(status()[5], 0)
    sim.input_tap("control_mode")
    sim.step(2)
    assert_eq(status()[5], 1)
    sim.input_mouse(50, 50)
    sim.step(5)
    assert_near(spin(ship), dvec3.new(0, 0, 0), 1e-9)
    sim.input_tap("control_mode")
    sim.step(2)
    assert_eq(status()[5], 0)
    for _ = 1, 5 do
        sim.input_mouse(50, 50)
        sim.step(1)
    end
    assert(dvec3.length(spin(ship)) > 0.05)
end)

test("key turn scale and slew soften the keyboard attitude input", function()
    local sharp = spawn_ship({ Assist = 0 })
    local soft = spawn_ship({ Assist = 0, KeyTurn = 0.25, KeySlew = 2 })
    scene.set64(soft, "Transform", "Position", dvec3.new(50, 0, 0))
    sim.input("yaw")
    sim.step(10)
    assert(math.abs(spin(soft).y) < math.abs(spin(sharp).y) * 0.5)
    assert(nose(sharp).x > nose(soft).x)
end)

test("two ships given the same recorded keys end in the identical state", function()
    local a = spawn_ship({ Assist = 1, ControlMode = 1, ThrottleRate = 2 })
    local b = spawn_ship({ Assist = 1, ControlMode = 1, ThrottleRate = 2 })
    scene.set64(b, "Transform", "Position", dvec3.new(100, 0, 0))
    sim.input("throttle")
    sim.step(20)
    sim.input("throttle", false)
    sim.input("yaw")
    sim.step(30)
    sim.input("yaw", false)
    sim.input_tap("speed_hold")
    sim.step(40)
    sim.input("kill_velocity")
    sim.input("pitch", -1)
    sim.step(40)
    assert_near(velocity(a), velocity(b), 1e-9)
    assert_near(spin(a), spin(b), 1e-9)
    assert_near(scene.get64(b, "Transform", "Position") - scene.get64(a, "Transform", "Position"), dvec3.new(100, 0, 0), 1e-6)
end)
