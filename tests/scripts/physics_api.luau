local STATIC, KINEMATIC, DYNAMIC = 0, 1, 2

local function body(name, position, kind, extra)
    local collider = { Shape = 0, HalfExtents = vector.create(1, 1, 1) }
    for key, value in extra or {} do collider[key] = value end
    local entity = sim.spawn(name, {
        Transform = { Position = position },
        RigidBody = { Type = kind, Mass = 2, EnableGravity = false },
        Collider = collider,
    })
    sim.set_velocity(entity, vector.create(0, 0, 0))
    return entity
end

local function velocity(entity) return scene.get(entity, "Velocity", "Linear") end
local function position(entity) return scene.get(entity, "Transform", "Position") end

test("raycast reports the closest entity, point, normal and distance", function()
    local near = body("Near", vector.create(0, 0, 10), STATIC)
    body("Far", vector.create(0, 0, 20), STATIC)
    sim.step(1)
    local hit = physics.raycast(vector.create(0, 0, 0), vector.create(0, 0, 1), 100)
    assert_eq(hit.entity, near)
    assert_near(hit.point, vector.create(0, 0, 9), 1e-3)
    assert_near(hit.normal, vector.create(0, 0, -1), 1e-4)
    assert_near(hit.distance, 9, 1e-3)
    assert_eq(physics.raycast(vector.create(0, 0, 0), vector.create(0, 0, 1), 5), nil)
    assert_eq(physics.raycast(vector.create(9, 0, 0), vector.create(0, 0, 1), 100), nil)
end)

test("raycast works 1e11 m from the origin through double tables", function()
    local target = body("Target", vector.create(0, 0, 0), STATIC)
    local x, y, z = 1e11, 5e10, -2e10
    scene.set_xyz(target, "Transform", "Position", x, y, z)
    sim.step(1)
    local hit = physics.raycast({ x = x, y = y, z = z - 10 }, { x = 0, y = 0, z = 1 }, 100)
    assert_eq(hit.entity, target)
    assert_near(hit.distance, 9, 1e-3)
    assert_near(hit.point64.x, x, 1)
    assert_near(hit.point64.z, z - 1, 1e-2)
    assert_eq(physics.overlap({ x = x, y = y, z = z }, 0.5), { target })
    assert_eq(physics.raycast({ x = 0, y = 0, z = 0 }, { x = 1, y = 0, z = 0 }, 1e6), nil)
end)

test("spherecast sweeps a sphere", function()
    local wall = body("Wall", vector.create(0, 0, 10), STATIC)
    sim.step(1)
    local hit = physics.spherecast(vector.create(0, 0, 0), 0.5, vector.create(0, 0, 1), 100)
    assert_eq(hit.entity, wall)
    assert_near(hit.distance, 8.5, 1e-3)
end)

test("overlap lists entities sorted by guid and honours the layer mask", function()
    local a = body("A", vector.create(0, 0, 0), STATIC)
    local b = body("B", vector.create(-2, 0, 0), STATIC, { Layer = 3 })
    local c = body("C", vector.create(2, 0, 0), STATIC)
    body("Out", vector.create(30, 0, 0), STATIC)
    sim.step(1)
    assert_eq(physics.overlap(vector.create(0, 0, 0), 2.5), { a, b, c })
    assert_eq(physics.overlap(vector.create(0, 0, 0), 2.5, 8), { b })
    assert_eq(physics.overlap(vector.create(0, 0, 0), 2.5, 0), {})
end)

test("add_impulse changes velocity by impulse over mass, at a point it spins the body", function()
    local pushed = body("Pushed", vector.create(0, 0, 0), DYNAMIC)
    local spun = body("Spun", vector.create(10, 0, 0), DYNAMIC)
    sim.step(1)
    physics.add_impulse(pushed, vector.create(4, 0, 0))
    physics.add_impulse(spun, vector.create(0, 0, 2), vector.create(10, 1, 0))
    assert_eq(velocity(pushed), vector.create(0, 0, 0))
    sim.step(1)
    assert_near(velocity(pushed), vector.create(2, 0, 0), 1e-4)
    assert_near(velocity(spun), vector.create(0, 0, 1), 1e-4)
    assert(math.abs(scene.get(spun, "Velocity", "Angular").x) > 0.01, "angular velocity from an off-centre impulse")
end)

test("add_force accelerates for every tick it is applied", function()
    local ball = body("Ball", vector.create(0, 0, 0), DYNAMIC)
    sim.step(1)
    for _ = 1, 10 do
        physics.add_force(ball, vector.create(6, 0, 0))
        sim.step(1)
    end
    assert_near(velocity(ball).x, 3 * 10 * sim.dt(), 1e-3)
end)

test("set_velocity and set_angular_velocity replace the motion", function()
    local ball = body("Ball", vector.create(0, 0, 0), DYNAMIC)
    sim.step(1)
    physics.set_velocity(ball, vector.create(0, 7, 0))
    physics.set_angular_velocity(ball, vector.create(0, 0, 3))
    sim.step(1)
    assert_near(velocity(ball), vector.create(0, 7, 0), 1e-4)
    assert_near(scene.get(ball, "Velocity", "Angular").z, 3, 0.05)
end)

test("impulses at 1e11 m behave", function()
    local ball = body("Ball", vector.create(0, 0, 0), DYNAMIC)
    local x, y, z = 1e11, -3e10, 2e10
    scene.set_xyz(ball, "Transform", "Position", x, y, z)
    sim.step(1)
    physics.add_impulse(ball, vector.create(10, 0, 0), { x = x, y = y, z = z })
    sim.step(60)
    assert_near(velocity(ball).x, 5, 1e-3)
    local px = scene.get_xyz(ball, "Transform", "Position")
    assert_near(px, x + 5 * 60 * sim.dt(), 0.1)
end)

test("set_kinematic_target moves a kinematic body exactly", function()
    local mover = body("Mover", vector.create(0, 0, 0), KINEMATIC)
    sim.step(1)
    physics.set_kinematic_target(mover, vector.create(3, 4, 5), vector.create(0, 90, 0))
    sim.step(1)
    local px, py, pz = scene.get_xyz(mover, "Transform", "Position")
    assert_eq({ px, py, pz }, { 3, 4, 5 })
    physics.set_kinematic_target(mover, { x = 3, y = 4, z = 9 })
    sim.step(1)
    assert_near(position(mover).z, 9, 1e-6)
end)

test("a fixed joint holds, break_joint releases", function()
    local anchor = body("Anchor", vector.create(0, 0, 0), STATIC)
    local held = body("Held", vector.create(0, 0, 5), DYNAMIC)
    sim.step(1)
    local joint = physics.create_joint(anchor, held, "fixed")
    assert_eq(physics.joint_broken(joint), false)
    physics.add_impulse(held, vector.create(0, 0, 40))
    sim.step(60)
    assert_near(position(held).z, 5, 0.05)
    assert_eq(physics.break_joint(joint), true)
    assert_eq(physics.break_joint(joint), false)
    assert_eq(physics.joint_broken(joint), nil)
    physics.add_impulse(held, vector.create(0, 0, 40))
    sim.step(30)
    assert(position(held).z > 10, "free after break_joint")
end)

test("a joint with a break force snaps under load", function()
    local wall = body("Wall", vector.create(0, 0, 0), STATIC)
    local weak = body("Weak", vector.create(0, 0, 5), DYNAMIC)
    sim.step(1)
    local joint = physics.create_joint(wall, weak, "fixed", { break_force = 50 })
    physics.add_impulse(weak, vector.create(0, 0, 40))
    sim.step(2)
    assert_eq(physics.joint_broken(joint), true)
    physics.add_impulse(weak, vector.create(0, 0, 40))
    sim.step(30)
    assert(position(weak).z > 10, "flew off after breaking")
end)

test("hinge and distance joints constrain motion", function()
    local door = body("Door", vector.create(0, 0, 0), DYNAMIC)
    local hook = body("Hook", vector.create(20, 0, 0), STATIC)
    local rope = body("Rope", vector.create(20, 0, 5), DYNAMIC)
    sim.step(1)
    physics.create_joint(door, nil, "hinge", { anchor = vector.create(0, 0, 0), axis = vector.create(0, 1, 0) })
    physics.create_joint(hook, rope, "distance", { distance = 5 })
    physics.add_impulse(door, vector.create(0, 0, 40), vector.create(1, 0, 0))
    physics.add_impulse(rope, vector.create(0, 0, 40))
    sim.step(60)
    assert_near(position(door).y, 0, 0.05)
    assert(vector.magnitude(position(rope) - position(hook)) < 6, "rope stays taut")
end)

test("layer and mask decide which bodies collide", function()
    body("Floor", vector.create(0, -3, 0), STATIC, { Layer = 2 })
    local ghost = body("Ghost", vector.create(0, 0, 0), DYNAMIC, { Layer = 1, Mask = 1 })
    body("Floor2", vector.create(30, -3, 0), STATIC, { Layer = 2 })
    local solid = body("Solid", vector.create(30, 0, 0), DYNAMIC, { Layer = 1 })
    sim.step(1)
    physics.set_velocity(ghost, vector.create(0, -5, 0))
    physics.set_velocity(solid, vector.create(0, -5, 0))
    sim.step(120)
    assert(position(ghost).y < -3, "ghost passes through the floor")
    assert(position(solid).y > -2, "solid rests on its floor")
end)

test("set_gravity_scale writes the RigidBody field", function()
    local ball = body("Ball", vector.create(0, 0, 0), DYNAMIC)
    physics.set_gravity_scale(ball, 0.25)
    assert_eq(scene.get(ball, "RigidBody", "GravityScale"), 0.25)
end)

test("bad arguments raise errors with a clear message", function()
    local floor = body("Floor", vector.create(0, 0, 0), STATIC)
    local free = sim.spawn("Free")
    local v = vector.create(1, 0, 0)
    sim.step(1)
    expect_error(function() physics.add_force(scene.find("Nobody"), v) end, "expected an entity")
    expect_error(function() physics.add_force(free, v) end, "entity 'Free' has no RigidBody and Collider")
    expect_error(function() physics.set_velocity(floor, v) end, "entity 'Floor' must be a Dynamic body")
    expect_error(function() physics.add_force(floor, "up") end, "force must be a vector")
    expect_error(function() physics.raycast(v, vector.create(0, 0, 0), 5) end, "direction must not be zero")
    expect_error(function() physics.create_joint(floor, floor, "fixed") end, "two different entities")
    expect_error(function() physics.create_joint(floor, free, "spring") end, "no RigidBody")
end)

test("two runs of the same physics script give the same hash", function()
    local a = body("A", vector.create(0, 0, 0), DYNAMIC)
    local b = body("B", vector.create(3, 0, 0), DYNAMIC)
    sim.step(1)
    physics.create_joint(a, b, "distance", { distance = 4, stiffness = 20, damping = 1 })
    for i = 1, 60 do
        physics.add_force(a, vector.create(math.random() * 4, 0, 0))
        physics.add_impulse(b, vector.create(0, 0.1, math.random()), vector.create(3, 0.5, 0))
        sim.step(1)
    end
    assert_eq(type(sim.state_hash()), "string")
end)
