#version 460

layout(local_size_x = 16, local_size_y = 16) in;

#include "real.glsl"

const float EPSILON = 0.00005f;

#include "scene_data.glsl"
#include "trace_common.glsl"
#include "kerr.glsl"
#include "noise.glsl"
#include "physics.glsl"
#include "crosshair.glsl"
#include "lut_loader.glsl"
#include "sphere.glsl"
#include "disk.glsl"
#include "debug_view.glsl"
#ifdef GPP_MESH_TRACE
#include "mesh_trace.glsl"
#endif
#include "ray_tracing.glsl"

void main() {
    ivec2 texCoords;
    if (!traceTexel(texCoords)) {
        return;
    }

    vec3 rayOrigin;
    vec3 rayDir;
    cameraRay(texCoords, rayOrigin, rayDir);

    vec3 color;
    vec3 hitPoint = vec3(0.0f);
    bool hitSolid = false;

    if (u_isPhysicallyAccurate == 1) {
        color = rk4RayMarching(rayOrigin, rayDir, hitPoint, hitSolid);
    }
    else {
        color = hybridRayTrace(rayOrigin, rayDir, hitPoint, hitSolid);
    }

    color = debugViewColor(color);

    float depth = hitSolid ? hitDepth(hitPoint) : FAR_DEPTH;
    imageStore(l_outputImage, texCoords, vec4(color, depth));
}
