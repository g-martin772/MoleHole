#version 460

// Mip chain of the 2D disk grid: every texel of mip k+1 is the mean of its 2x2 children of mip k (extensive densities
// per plane area, so the mean is the density over the larger cell). Notes: docs/notes/particle-disk.md

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D u_srcA;
layout(set = 0, binding = 1) uniform sampler2D u_srcB;
layout(set = 0, binding = 2, rgba32f) uniform writeonly image2D u_dstA;
layout(set = 0, binding = 3, rg32f) uniform writeonly image2D u_dstB;

layout(push_constant) uniform Push { int srcLod; int dstSize; int srcSize; };

void main() {
    ivec2 v = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(v, ivec2(dstSize)))) return;
    vec4 a = vec4(0.0);
    vec2 b = vec2(0.0);
    float count = 0.0;
    for (int dy = 0; dy < 2; ++dy) {
        for (int dx = 0; dx < 2; ++dx) {
            ivec2 s = v * 2 + ivec2(dx, dy);
            if (any(greaterThanEqual(s, ivec2(srcSize)))) continue;
            a += texelFetch(u_srcA, s, srcLod);
            b += texelFetch(u_srcB, s, srcLod).xy;
            count += 1.0;
        }
    }
    float inv = count > 0.0 ? 1.0 / count : 0.0;
    imageStore(u_dstA, v, a * inv);
    imageStore(u_dstB, v, vec4(b * inv, 0.0, 0.0));
}
