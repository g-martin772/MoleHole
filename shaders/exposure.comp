#version 450

// Exposure for the tone mapper, written to a 1x1 image read by bloom_extract.comp and blackhole_display.frag.
// Manual: 2^EV. Auto: key / log-average luminance (Reinhard et al. 2002) of the pixels within 1/100 of the
// brightest sample, times 2^EV, so a frame that is mostly dark sky is metered on its subject.
// Physical camera: scale from aperture, shutter and ISO (EV100 model, image value 1 = 203 cd/m^2) times 2^EV.
// Disabled (no tone mapping): 1, so the raw tracer output is shown unchanged.
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D u_inputImage;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D u_exposureImage;

layout(push_constant) uniform PushConstants
{
    int u_enabled;
    int u_auto;
    float u_ev;
    float u_key;
    float u_physicalScale; // > 0: physical camera, replaces manual and auto
};

shared float s_max[256];
shared float s_logSum[256];
shared float s_count[256];

// 16x16 threads meter a 64x64 grid spread over the image, 16 samples each.
float meterSample(int i, int j, ivec2 size) {
    vec2 uv = (vec2(gl_LocalInvocationID.xy * 4u + uvec2(i, j)) + 0.5) / 64.0;
    vec3 color = imageLoad(u_inputImage, ivec2(uv * vec2(size))).rgb;
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    uint id = gl_LocalInvocationIndex;
    ivec2 size = imageSize(u_inputImage);
    bool metering = u_enabled == 1 && u_auto == 1;

    // Pass 1: brightest sample.
    float brightest = 0.0;
    if (metering) {
        for (int j = 0; j < 4; j++) {
            for (int i = 0; i < 4; i++) brightest = max(brightest, meterSample(i, j, size));
        }
    }
    s_max[id] = brightest;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (id < stride) s_max[id] = max(s_max[id], s_max[id + stride]);
        barrier();
    }
    float floorLuminance = max(s_max[0] * 0.01, 1e-6);

    // Pass 2: log-average of the samples above the floor.
    float logSum = 0.0;
    float count = 0.0;
    if (metering) {
        for (int j = 0; j < 4; j++) {
            for (int i = 0; i < 4; i++) {
                float luminance = meterSample(i, j, size);
                if (luminance > floorLuminance) {
                    logSum += log(luminance);
                    count += 1.0;
                }
            }
        }
    }
    s_logSum[id] = logSum;
    s_count[id] = count;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (id < stride) {
            s_logSum[id] += s_logSum[id + stride];
            s_count[id] += s_count[id + stride];
        }
        barrier();
    }

    if (id == 0u) {
        float exposure = 1.0;
        if (u_enabled == 1) {
            exposure = exp2(u_ev);
            if (u_physicalScale > 0.0) {
                exposure *= u_physicalScale;
            } else if (u_auto == 1 && s_count[0] > 0.0) {
                exposure *= u_key / exp(s_logSum[0] / s_count[0]);
            }
        }
        imageStore(u_exposureImage, ivec2(0), vec4(exposure));
    }
}
